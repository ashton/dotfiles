font-family = JetBrainsMono Nerd Font Propo Regular
font-family-bold = JetBrainsMono Nerd Font Propo Bold
font-family-italic = JetBrainsMono Nerd Font Propo Medium Italic
font-family-bold-italic = JetBrainsMono Nerd Font Propo Bold Italic
font-size = 14
theme = ayu
cursor-style = block
cursor-style-blink = false
window-theme = dark
copy-on-select = true
shell-integration = zsh
shell-integration-features = no-cursor
desktop-notifications = true
quick-terminal-screen = macos-menu-bar

keybind = cmd+q=quit
keybind = cmd+t=new_tab
keybind = cmd+n=new_window
keybind = ctrl+w=close_window
keybind = ctrl+shift+w=close_all_windows
keybind = cmd+enter=toggle_fullscreen
keybind = cmd+shift+left_bracket=previous_tab
keybind = cmd+shift+right_bracket=next_tab
keybind = cmd+one=goto_tab:1
keybind = cmd+two=goto_tab:2
keybind = cmd+three=goto_tab:3
keybind = cmd+four=goto_tab:4
keybind = cmd+five=goto_tab:5
keybind = cmd+six=goto_tab:6
keybind = cmd+seven=goto_tab:7
keybind = cmd+eight=goto_tab:8
keybind = cmd+nine=goto_tab:9
keybind = cmd+zero=goto_tab:100
keybind = cmd+d=new_split:right
keybind = cmd+equal=equalize_splits
keybind = cmd+left_bracket=goto_split:previous
keybind = cmd+right_bracket=goto_split:next
keybind = cmd+shift+l=resize_split:right,10
keybind = cmd+shift+h=resize_split:left,10
keybind = cmd+shift+j=resize_split:down,10
keybind = cmd+shift+k=resize_split:up,10
keybind = cmd+l=goto_split:right
keybind = cmd+h=goto_split:left
keybind = cmd+j=goto_split:bottom
keybind = cmd+k=goto_split:top
keybind = cmd+w=close_surface
keybind = cmd+shift+d=new_split:down
keybind = cmd+shift+f=toggle_split_zoom
keybind = cmd+shift+r=reload_config
keybind = global:f12=toggle_quick_terminal
